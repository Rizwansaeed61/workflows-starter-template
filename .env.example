# Environment Variables Template for Rizwan Saeed Portfolio

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="https://rizwansaddique.site"

# Supabase PostgreSQL Database Configuration
# Transaction / Session Pooler URL (for app runtime)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct Database URL (for Prisma migrations and db push)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Public API Configuration (Optional)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Contact Form Email Delivery (Resend API optional integration)
# Supply your Resend API Key to activate real email delivery for form submissions
RESEND_API_KEY="re_123456789_your_resend_api_key"
CONTACT_NOTIFICATION_EMAIL="Hello@RizwanSaddique.site"

# Analytics Integration Points (Optional — Script tags only load when IDs are provided)
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-526Z6DN7"
NEXT_PUBLIC_META_PIXEL_ID="1234567890"
NEXT_PUBLIC_LINKEDIN_TAG_ID="123456"
